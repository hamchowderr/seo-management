# ===========================================
# SEO Monster Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# ===========================================
# Supabase (Required)
# ===========================================
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Application URL (Required)
# ===========================================
# Local development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# AI Content Generation (Optional)
# ===========================================
# Get from: Vercel Dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# ===========================================
# Google Drive Integration (Optional)
# ===========================================
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional - defaults to NEXT_PUBLIC_APP_URL/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# ===========================================
# Slack Integration (Optional)
# ===========================================
# Get from: Slack API → Your Apps → OAuth & Permissions
SLACK_BOT_TOKEN=

# ===========================================
# Email via Resend (Optional)
# ===========================================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
# Sender email - must be verified domain in Resend
RESEND_FROM_EMAIL=SEO Monster <notifications@yourdomain.com>
